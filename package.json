{
  "name": "maxzhang.site",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:tsc && pnpm lint:eslint && pnpm lint:prettier && prisma format",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\"",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@thumbmarkjs/thumbmarkjs": "^1.7.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "escape-html": "^1.0.3",
    "framer-motion": "^12.33.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.3",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-tweet": "^3.3.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
