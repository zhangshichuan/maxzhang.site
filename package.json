{
  "name": "maxzhang.site",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/dev.mjs --clean",
    "dev:web": "pnpm --filter web dev",
    "dev:services": "node scripts/dev.mjs --services-only",
    "dev:otel": "docker compose -f docker-compose.observability.yml up -d",
    "dev:otel:stop": "docker compose -f docker-compose.observability.yml down",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "test": "pnpm --filter web test",
    "test:watch": "pnpm --filter web test:watch",
    "lint": "pnpm --filter web lint",
    "lint:tsc": "pnpm --filter web lint:tsc",
    "lint:eslint": "pnpm --filter web lint:eslint",
    "lint:prettier": "pnpm --filter web lint:prettier",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:studio": "pnpm --filter web db:studio"
  }
}
