# 存储服务（NestJS）本地环境变量
# 复制为 apps/services/storage/.env 使用；.env 已被 gitignore，不会提交。
# 生产环境的密钥由部署平台/CI 注入，不依赖本文件。

# 服务端口（docker-compose 内网暴露）
PORT=9001

# Web 调用存储服务时携带的内部 API key（两边保持一致）
STORAGE_API_KEY=

# 存储后端：local（服务器本地磁盘，默认）或 qiniu
STORAGE_PROVIDER=local

# 本地磁盘目录：dev 下指向 Web 的 public/photos（Vite 直接伺服），
# 生产由 docker-compose 注入 /data/photos 共享卷
PHOTOS_DIR=../../web/public/photos

# 七牛 Kodo 配置（STORAGE_PROVIDER=qiniu 时启用，需已备案域名）
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=
# QINIU_UPLOAD_HOST=https://upload.qiniup.com
# QINIU_RS_HOST=https://rs.qiniu.com

# 单次上传限制
# MAX_PHOTOS_PER_WORK=10
# MAX_PHOTO_BYTES=52428800
