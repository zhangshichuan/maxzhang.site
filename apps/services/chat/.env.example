# 聊天服务（Go）本地环境变量
# 复制为 apps/services/chat/.env 使用；.env 已被 gitignore，不会提交。
# 生产环境的密钥由部署平台/CI 注入，不依赖本文件。

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT_SECONDS=180
# PORT=9000

# 全局预算：按估算字符数计，包含人物提示词、历史和输出。
# 5,000,000 大约是 60 次单聊或 20 次三人桌；按自己的额度调整。
CHAT_DAILY_BUDGET_CHARS=5000000
# 同时进行的夜宴请求上限；超过返回 SERVICE_BUSY。
CHAT_MAX_CONCURRENCY=6
# 每日全局请求上限，作为预算之外的兜底。
DEEPSEEK_DAILY_LIMIT=1000
# 配额状态文件；Docker 中挂载到 /app/data，本地默认 /tmp。
# CHAT_STATE_FILE=/app/data/night-banquet-quota.json
