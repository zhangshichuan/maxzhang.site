{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-mdx.mjs && vite dev",
    "build": "node scripts/generate-mdx.mjs && vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:tsc && pnpm lint:eslint && pnpm lint:prettier && prisma format",
    "lint:tsc": "node scripts/generate-mdx.mjs && tsc --noEmit",
    "lint:eslint": "eslint --fix",
    "lint:prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,mdx}\" --ignore-path ../../.prettierignore",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.0",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@tailwindcss/typography": "^0.5.19",
    "@thumbmarkjs/thumbmarkjs": "^1.7.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "escape-html": "^1.0.3",
    "framer-motion": "^12.33.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.12.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-tweet": "^3.3.0",
    "reading-time": "^1.5.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.5",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/start-storage-context": "^1.167.17",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-react-hooks": "^5",
    "husky": "^9.1.7",
    "nitro": "^3.0.260610-beta",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.2"
  }
}
