datasource db {
  provider = "sqlite"
  // 体量小，所以默认会有真实的外键约束，如果需要禁用外键约束，可以添加 relationMode="prisma"。
  // relationMode="prisma"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model PostView {
  slug      String
  locale    String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([slug, locale])
}

model ViewLog {
  id          Int      @id @default(autoincrement())
  fingerprint String
  slug        String
  locale      String
  createdAt   DateTime @default(now())

  @@index([fingerprint, slug, locale])
}

model Comment {
  id          Int      @id @default(autoincrement())
  slug        String
  fingerprint String
  content     String   @default("")
  createdAt   DateTime @default(now())
  parentId    Int?

  parent  Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies Comment[] @relation("Replies")

  @@index([slug])
  @@index([parentId])
}

model CommentLog {
  id          Int      @id @default(autoincrement())
  fingerprint String
  slug        String
  createdAt   DateTime @default(now())

  @@index([fingerprint, slug])
}

model PhotoWork {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  captionZh  String
  captionEn  String   @default("")
  takenAt    DateTime
  location   String?
  tags       String   @default("[]")
  coverIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  photos     Photo[]

  @@index([takenAt])
}

model Photo {
  id        Int       @id @default(autoincrement())
  workId    Int
  sortIndex Int       @default(0)
  largeKey  String
  thumbKey  String
  largeUrl  String
  thumbUrl  String
  width     Int
  height    Int
  camera    String?
  lens      String?
  focal     String?
  aperture  String?
  shutter   String?
  iso       String?
  work      PhotoWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
}

model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
