datasource db {
  provider = "sqlite"
  // 体量小，所以默认会有真实的外键约束，如果需要禁用外键约束，可以添加 relationMode="prisma"。
  // relationMode="prisma"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model PostView {
  slug      String
  locale    String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([slug, locale])
}

model ViewLog {
  id          Int      @id @default(autoincrement())
  fingerprint String
  slug        String
  locale      String
  createdAt   DateTime @default(now())

  @@index([fingerprint, slug, locale])
}

model Comment {
  id          Int      @id @default(autoincrement())
  slug        String
  fingerprint String
  content     String   @default("")
  createdAt   DateTime @default(now())
  parentId    Int?

  parent  Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies Comment[] @relation("Replies")

  @@index([slug])
  @@index([parentId])
}

model CommentLog {
  id          Int      @id @default(autoincrement())
  fingerprint String
  slug        String
  createdAt   DateTime @default(now())

  @@index([fingerprint, slug])
}
