# Web 本地环境变量
# 复制为 apps/web/.env 使用；.env 已被 gitignore，不会提交。

# Prisma 本地 SQLite
DATABASE_URL=file:./prisma/dev.db

# 内部接口测试 key（本地默认即可）
PUSH_API_KEY=test-key-123

# 可选：覆盖默认的后端地址
# TTS_BASE_URL=http://localhost:8001
# CHAT_BASE_URL=http://localhost:9000
# STORAGE_BASE_URL=http://localhost:9001

# 摄影存储服务内部 API key（与 apps/services/storage/.env 保持一致）
# STORAGE_API_KEY=

# 摄影管理后台口令；未设置时后台不可用
# ADMIN_PASSWORD=

# 可选：管理接口 IP 白名单（逗号分隔，支持 IPv4 与 CIDR）；
# 配置后只有这些 IP 能登录与执行管理操作
# ADMIN_ALLOWED_IPS=203.0.113.1,198.51.100.0/24

# 生产环境置 1，Cookie 加 Secure；本地 http 开发不要开
# COOKIE_SECURE=1
