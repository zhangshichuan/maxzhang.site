datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model PostView {
  slug      String
  locale    String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([slug, locale])
}

model ViewLog {
  id          Int      @id @default(autoincrement())
  fingerprint String
  slug        String
  locale      String
  createdAt   DateTime @default(now())

  @@index([fingerprint, slug, locale])
}

model Comment {
  id          Int      @id @default(autoincrement())
  slug        String
  fingerprint String
  content     String   @default("")
  createdAt   DateTime @default(now())

  @@index([slug])
}

model CommentLog {
  id          Int      @id @default(autoincrement())
  fingerprint String
  slug        String
  createdAt   DateTime @default(now())

  @@index([fingerprint, slug])
}
